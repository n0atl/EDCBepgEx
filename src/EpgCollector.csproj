<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EDCBepgEx</AssemblyName>
    <Product>EDCBepgEx</Product>
    <ApplicationIcon>../assets/EDCBepgEx.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../assets/EDCBepgEx.ico" LogicalName="EDCBepgEx.AppIcon" />
  </ItemGroup>
</Project>
